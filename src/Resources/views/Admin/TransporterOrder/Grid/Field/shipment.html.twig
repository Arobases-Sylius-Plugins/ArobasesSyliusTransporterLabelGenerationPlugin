{% if data and data|length > 0 %}
    {% for shipment in data %}
        {% if shipment.transporterCode in ["COM", "CDS"] %}
            {% set allHsCodeValid = arobases_label_generation_has_all_hs_code(shipment.order) %}
            {% if not allHsCodeValid %}
                <div class="text-danger small mb-1">{{ "arobases_sylius_transporter_label_generation_plugin.ui.error_message_hs_code"|trans }}</div>
            {% endif %}
        {% endif %}
        {% if shipment.transporter %}
            <div data-transporter-code="{{ shipment.transporterCode }}">
                {{ render(url('arobases_sylius_transporter_label_generation_plugin_admin_render_update_transporter_shipment_form', {transporterId: shipment.transporter.id, shipmentId: shipment.id, orderId: shipment.order.id})) }}
            </div>
        {% endif %}
    {% endfor %}
{% endif %}
