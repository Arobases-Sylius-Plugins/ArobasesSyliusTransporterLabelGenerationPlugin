{% if data %}
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-icon btn-primary open-order-row" data-transporter="{{ app.request.attributes.get('id') }}" data-number="{{ data }}" data-render-order-url="{{ path('arobases_sylius_transporter_label_generation_plugin_admin_render_order_details', { number: data }) }}">{{ ux_icon('tabler:plus', {class: 'icon m-0 icon-plus'}) }}{{ ux_icon('tabler:minus', {class: 'icon m-0 icon-minus d-none'}) }}</button>
        {{ data }}
    </div>
{% endif %}
