{% if labels|length > 0 %}
    <div class="d-flex align-items-center gap-2 border-bottom pb-2 mt-4 mb-3">
        <h3 class="card-title mb-0">{{ 'arobases_sylius_transporter_label_generation_plugin.ui.summary'|trans }}</h3>
        {% if orderSent is defined and orderSent %}
            <span class="badge bg-green-lt">{{ 'arobases_sylius_transporter_label_generation_plugin.order.order_sent'|trans }}</span>
        {% elseif orderSent is not defined or (orderSent == false and countLabelItems < 1) %}
            <span class="badge bg-red-lt">{{ 'arobases_sylius_transporter_label_generation_plugin.order.order_not_sent'|trans }}</span>
        {% elseif orderSent == false and countLabelItems > 0 %}
            <span class="badge bg-orange-lt">{{ 'arobases_sylius_transporter_label_generation_plugin.order.order_partially_sent'|trans }}</span>
        {% endif %}
    </div>
    <h4>{{ 'arobases_sylius_transporter_label_generation_plugin.ui.sent_products'|trans }}</h4>
    <div class="table-responsive mb-3">
        <table class="table table-sm table-vcenter">
            <thead>
            <tr>
                <th>{{ 'arobases_sylius_transporter_label_generation_plugin.label_item.product_name'|trans }}</th>
                <th>{{ 'arobases_sylius_transporter_label_generation_plugin.label_item.quantity'|trans }}</th>
                <th>{{ 'arobases_sylius_transporter_label_generation_plugin.label_item.tracking_number'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for label in labels %}
                {% for item in label.labelItems %}
                    <tr>
                        <td>{{ item.orderItem ? item.orderItem.variant.translation.name }}</td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ label.trackingNumber }}</td>
                    </tr>
                {% endfor %}
            {% endfor %}
            </tbody>
        </table>
    </div>
    <h4>{{ 'arobases_sylius_transporter_label_generation_plugin.ui.generated_labels'|trans }}</h4>
    <div class="table-responsive">
        <table class="table table-sm table-vcenter">
            <thead>
            <tr>
                <th>{{ 'arobases_sylius_transporter_label_generation_plugin.label.tracking_number'|trans }}</th>
                <th>{{ 'arobases_sylius_transporter_label_generation_plugin.label.simple_label'|trans }}</th>
                <th>{{ 'arobases_sylius_transporter_label_generation_plugin.label.cn23'|trans }}</th>
                <th class="w-1"></th>
            </tr>
            </thead>
            <tbody>
            {% for label in labels %}
                <tr>
                    <td>{{ label.trackingNumber }}</td>
                    <td>
                        {% if label.path %}
                            <a class="btn btn-icon btn-sm" href="{{ path('arobases_sylius_transporter_label_generation_plugin_admin_label_download', {labelId: label.id, document: 'label'}) }}" download>{{ ux_icon('tabler:download', {class: 'icon m-0'}) }}</a>
                        {% endif %}
                    </td>
                    <td>
                        {% if label.pathCn23 %}
                            <a class="btn btn-icon btn-sm" href="{{ path('arobases_sylius_transporter_label_generation_plugin_admin_label_download', {labelId: label.id, document: 'cn23'}) }}" download>{{ ux_icon('tabler:download', {class: 'icon m-0'}) }}</a>
                        {% endif %}
                    </td>
                    <td>
                        <button type="button" class="btn btn-icon btn-sm btn-outline-danger delete-label-btn" data-delete-url="{{ path('arobases_sylius_transporter_label_generation_plugin_admin_label_delete_ajax', {labelId: label.id}) }}" data-token="{{ csrf_token('arobases_delete_label_' ~ label.id) }}">{{ ux_icon('tabler:trash', {class: 'icon m-0'}) }}</button>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="mt-4"><span class="badge bg-red-lt">{{ 'arobases_sylius_transporter_label_generation_plugin.order.order_not_sent'|trans }}</span></div>
{% endif %}
